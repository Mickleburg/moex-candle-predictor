# Execution block secrets/flags — COPY to execution/.env and fill in. NEVER commit the real .env.
# .env is gitignored. Broker secrets live only here or in a secret store, never in code or git.

# --- Live gate (defense in depth) -------------------------------------------------------
# Live trading also requires ExecutionConfig.allow_live=True in code. BOTH must hold.
# Leave unset/0 for dry-run and paper. Set to 1 only after the shadow gate + team sign-off.
EXECUTION_ALLOW_LIVE=0

# --- T-Invest (Tinkoff Invest) credentials ---------------------------------------------
# Sandbox token for paper (broker_backend=tinvest); production token only for live.
TINVEST_TOKEN=
TINVEST_ACCOUNT_ID=
