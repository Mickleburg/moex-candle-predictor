# MOEX autonomous agent — environment template. Copy to `.env` (gitignored) and fill in.
# NEVER commit real secrets. On the VDS, load via docker compose `env_file` or systemd
# EnvironmentFile (/etc/moex-agent.env, chmod 600).

# --- run mode (override agent/config/agent_config.json) ---
# mode: dry-run | paper | live   (live ALSO requires AGENT_ENABLE_LIVE=true — paper-first)
AGENT_MODE=paper
# block wiring: mock | live   (mock runs end-to-end with no other block; flip as blocks land)
AGENT_BLOCK_MODE=mock
# hard gate for real-money trading. Keep false until shadow-gate + team sign-off.
AGENT_ENABLE_LIVE=false
# AGENT_CAPITAL_RUB=10000000

# --- alerts (digest / data-HALT / dead-man's-switch) ---
# channel: stdout | telegram
AGENT_ALERT_CHANNEL=stdout
# Telegram bot (required only when AGENT_ALERT_CHANNEL=telegram). Create via @BotFather.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- timezone (cron triggers fire on Europe/Moscow wall-clock) ---
TZ=Europe/Moscow

# --- broker credentials (consumed by the execution block; live path only) ---
# T-Invest API is the recommended sandbox-first path. Leave blank for paper/sandbox-less runs.
TINVEST_TOKEN=
TINVEST_ACCOUNT_ID=
# BROKER_SANDBOX=true
