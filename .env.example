# MOEX autonomous agent — environment template. Copy to `.env` (gitignored) and fill in.
# NEVER commit real secrets. On the VDS, load via docker compose `env_file` or systemd
# EnvironmentFile (/etc/moex-agent.env, chmod 600).
#
# ── FILL-IN CHECKLIST (by phase) ───────────────────────────────────────────────
#   [ ] PAPER now      nothing required — defaults run the EOD cycle in paper/mock safely.
#   [ ] BOT monitoring TELEGRAM_BOT_TOKEN + BOT_ALLOWED_CHAT_IDS (+ TELEGRAM_CHAT_ID for push alerts).
#   [ ] BROKER hookup  TINVEST_TOKEN (sandbox/read-only) — unlocks FIGI verify + sandbox wire-test.
#   [ ] LIVE later     AGENT_ENABLE_LIVE=true + EXECUTION_ALLOW_LIVE=1 + full-access TINVEST_TOKEN
#                      + TINVEST_ACCOUNT_ID — ONLY after verified FIGIs + shadow-gate MET + sign-off.
# ───────────────────────────────────────────────────────────────────────────────

# === run mode (override agent/config/agent_config.json) ===
# mode: dry-run | paper | live   (live ALSO requires the two live gates below — paper-first)
AGENT_MODE=paper
# block wiring: mock | live   (mock runs end-to-end with no other block; flip as blocks land)
AGENT_BLOCK_MODE=mock
# AGENT_CAPITAL_RUB=10000000
# timezone — scheduler triggers fire on Europe/Moscow wall-clock
TZ=Europe/Moscow

# === alerts: agent PUSH digest / data-HALT / dead-man's-switch (agent/src/notifier.py) ===
# channel: stdout | telegram
AGENT_ALERT_CHANNEL=stdout
# Telegram bot token — create via @BotFather. Reused by the bot/ monitoring chat (one token, one poller).
TELEGRAM_BOT_TOKEN=
# chat the agent SENDS alerts to (your personal chat id; message @userinfobot to get it)
TELEGRAM_CHAT_ID=
# OPTIONAL proxy for Telegram ONLY (bot poller + agent push notifier) — needed where api.telegram.org
# is blocked (e.g. a Russian VDS: RKN). Point at an out-of-region HTTP proxy locked to this host's IP,
# e.g. http://<proxy-ip>:<port>. Leave blank if Telegram is directly reachable. ISS stays direct.
TELEGRAM_PROXY_URL=

# === Telegram monitoring bot (block bot/) ===
# bootstrap admin chat id(s): may run the management commands (/users /allow /deny) and can NEVER
# be removed via the bot (fail-safe so you can't lock yourself out). Message @userinfobot for your id.
BOT_ADMIN_CHAT_IDS=
# comma-separated seed whitelist of chat ids allowed to QUERY the bot (read-only). Admins are always
# allowed; runtime additions via /allow are persisted separately. EMPTY + no admins => bot won't start.
BOT_ALLOWED_CHAT_IDS=
# getUpdates long-poll timeout in seconds (optional; default 30).
# BOT_POLL_TIMEOUT=30

# === broker (execution block — T-Invest API, sandbox-first) ===
# Generate at T-Bank/Tinkoff Invest -> Settings -> API. Start with a SANDBOX or READ-ONLY token.
TINVEST_TOKEN=
# brokerage account id (from the API once the account is open; needed for live/sandbox order routing)
TINVEST_ACCOUNT_ID=

# === LIVE TRADING GATES (both required on top of mode=live) — keep OFF until sign-off ===
# agent-side gate (agent/src/config.py): true enables the live path in the orchestrator
AGENT_ENABLE_LIVE=false
# execution-side gate (execution/src/config.py): 1 lets the broker place REAL orders
EXECUTION_ALLOW_LIVE=0

# === LLM provider (optional — V2 news-analysis path; NOT needed for the H9 dividend feed) ===
# The dividend feed extracts from e-disclosure bodies directly; these only matter if the
# llm/ analyzer (llm/src/llm_ta/providers.py) is used. Leave blank otherwise.
# LLM_OPENAI_API_KEY=
# LLM_OPENAI_BASE_URL=
# LLM_MODEL=
