{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MlPrediction",
  "type": "object",
  "required": ["ticker", "timeframe", "as_of", "model_version", "model_family", "target", "probabilities", "confidence", "diagnostics"],
  "properties": {
    "ticker": { "type": "string" },
    "timeframe": { "type": "string" },
    "as_of": { "type": "string", "format": "date-time" },
    "model_version": { "type": "string" },
    "model_family": { "type": "string" },
    "target": { "type": "string" },
    "probabilities": {
      "type": "object",
      "required": ["buy", "hold", "sell"],
      "properties": {
        "buy": { "type": "number", "minimum": 0, "maximum": 1 },
        "hold": { "type": "number", "minimum": 0, "maximum": 1 },
        "sell": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "expected_return": { "type": ["number", "null"] },
    "diagnostics": {
      "type": "object",
      "properties": {
        "feature_set": { "type": "string" },
        "validation_macro_f1": { "type": "number" },
        "is_production": { "type": "boolean" }
      },
      "additionalProperties": true
    }
  }
}
