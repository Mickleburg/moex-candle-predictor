{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LlmAnalysis",
  "type": "object",
  "required": ["ticker", "timeframe", "as_of", "technical_view", "probabilities", "confidence", "key_reasons", "risk_notes"],
  "properties": {
    "ticker": { "type": "string" },
    "timeframe": { "type": "string" },
    "as_of": { "type": "string", "format": "date-time" },
    "technical_view": { "type": "string" },
    "probabilities": {
      "type": "object",
      "required": ["buy", "hold", "sell"],
      "properties": {
        "buy": { "type": "number", "minimum": 0, "maximum": 1 },
        "hold": { "type": "number", "minimum": 0, "maximum": 1 },
        "sell": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "key_reasons": { "type": "array", "items": { "type": "string" } },
    "risk_notes": { "type": "array", "items": { "type": "string" } }
  }
}
